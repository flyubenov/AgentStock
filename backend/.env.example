# Backend environment variables. Copy to `.env` for local dev (loaded by
# python-dotenv), or set these as secrets in your cloud host's dashboard.

# --- Required ---
# The Google Sheet the app reads/writes as its database.
GOOGLE_SHEETS_ID=your-spreadsheet-id-here

# Credentials — choose ONE:
# (a) Local dev: path to the service-account key file (default shown).
GOOGLE_SHEETS_CREDS_PATH=./credentials/service_account.json
# (b) Cloud: paste the entire service-account JSON as a single-line string.
#     When set, this takes precedence over GOOGLE_SHEETS_CREDS_PATH.
# GOOGLE_SHEETS_CREDS_JSON={"type":"service_account","project_id":"...", ...}

# --- Deployment ---
# Comma-separated allowed frontend origins (defaults to local Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Optional tuning (defaults are sensible; override only if needed) ---
# YF_MAX_WORKERS=8
# RECALC_CONCURRENCY=3
# SHEETS_MAX_RETRIES=6
