# Frontend build-time environment. Copy to `.env` for local dev, or set in your
# host's dashboard (Vercel / Render). Vite only exposes vars prefixed with VITE_.

# Backend API base URL. Leave unset locally to default to http://localhost:8000.
# In the cloud, set this to your deployed backend, e.g.:
#   VITE_API_BASE=https://agentstock-backend-xxxx.run.app
VITE_API_BASE=http://localhost:8000
